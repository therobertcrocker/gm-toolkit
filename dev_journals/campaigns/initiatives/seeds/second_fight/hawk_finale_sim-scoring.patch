 # --------------------------------------------------------------------- scoring
+# ------------------------------------------------------------ plain measures
+BIG_FRAC = 0.15        # a single party hit worth 15%+ of the boss's max HP is a big moment
+CLOSE_LOW = 0.25       # close call: party total HP falls to 25% or less...
+CLOSE_DOWNS = 2        # ...or this many knockdowns
+MOMENTS_PER_ROUND = 0.5   # great needs at least one big moment per two rounds
+
+def round_end(party, boss_frac):
+    """Call at the end of every round. boss_frac = boss HP left / boss HP total (both phases)."""
+    pf = sum(max(p.hp, 0) for p in party if not p.dead) / sum(p.maxhp for p in party)
+    diff = pf - boss_frac
+    TRACK["diffs"].append(diff)
+    sign = 1 if diff > 0.02 else -1 if diff < -0.02 else 0
+    if sign and TRACK["lead_sign"] and sign != TRACK["lead_sign"]:
+        TRACK["lead_changes"] += 1
+    if sign: TRACK["lead_sign"] = sign
+
+def measures(res):
+    """Plain per-fight measures, plus the rebuilt great/flat call."""
+    import math
+    win = res["result"] == "win"
+    downs = sum(STATS["downs"].values())
+    close = TRACK["low"] <= CLOSE_LOW or downs >= CLOSE_DOWNS
+    d = TRACK["diffs"]
+    late = d[len(d) // 2:] if d else []
+    lead = win and any(x < -0.02 for x in late)          # losing the HP race in the second half, and won
+    need = max(1, math.ceil(MOMENTS_PER_ROUND * len(d)))
+    big = TRACK["moments"] >= need
+    k = close + lead + big
+    clean = win and not res["deaths"]
+    return dict(win=win, death=bool(res["deaths"]), low=TRACK["low"], close=close, downs=downs,
+                lead=lead, moments=TRACK["moments"], big=big, k=k,
+                dramatic=clean and k == 3,          # confidently dramatic: all three
+                leans=clean and k == 2,             # leans dramatic: two of three
+                one=clean and k == 1, flat=win and k == 0)
+
+def dashboard(ms):
+    n = len(ms); f = lambda k: sum(m[k] for m in ms) / n
+    return dict(win=f("win"), wipe=1 - f("win"), death=f("death"), low=f("low"), close=f("close"),
+                downs=f("downs"), lead=f("lead"), moments=f("moments"), big=f("big"),
+                dramatic=f("dramatic"), leans=f("leans"), one=f("one"), flat=f("flat"))
+
+def show_dashboard(db, rounds=None, label=""):
+    print(f"{label}")
+    print(f"  Outcome      win {db['win']:.0%}  wipe {db['wipe']:.1%}  a PC dies {db['death']:.1%}" + (f"  rounds {rounds:.1f}" if rounds else ""))
+    print(f"  Close call   {db['close']:.0%} of fights (party HP to 25% or 2+ knockdowns; low point {db['low']:.0%} on average, {db['downs']:.1f} knockdowns)")
+    print(f"  Lead change  {db['lead']:.0%} of fights (behind in the second half, and won)")
+    print(f"  Big moments  {db['moments']:.1f} per fight; at least 1 per 2 rounds in {db['big']:.0%}")
+    print(f"  Dramatic {db['dramatic']:.0%} (all 3)   Leans dramatic {db['leans']:.0%} (2 of 3)   One {db['one']:.0%}   Flat {db['flat']:.0%} (none)"
+          "   [clean wins only: no PC death]")
+

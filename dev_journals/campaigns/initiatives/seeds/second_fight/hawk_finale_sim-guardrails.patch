+"""PF2e guardrails for the encounter sims: GM Core creature benchmarks and the encounter budget.
+
+Source: GM Core, Building Creatures (Tables 2-2, 2-5 to 2-12) and Encounter Budget (Tables 10-1, 10-2).
+Only levels 14-20 are entered; add rows as campaigns need them.
+
+    from pf2e_benchmarks import check_creature, print_checks, encounter_readout
+"""
+
+# ---------------------------------------------------------------- tables
+# Extreme / High / Moderate / Low / Terrible
+PERCEPTION = {14: (30, 28, 25, 22, 19), 15: (32, 29, 26, 23, 20), 16: (33, 30, 28, 25, 22),

+def win_chance(party, ctx):
+    global STATS, TRACK, IN_ROLLOUT, LOGGING
+    import copy
+    saved = (STATS, TRACK, LOGGING); IN_ROLLOUT = True; LOGGING = False
+    wins = 0
+    try:
+        for _ in range(WINCHANCE_N):
+            p2, c2, STATS, TRACK = copy.deepcopy((party, ctx, saved[0], saved[1]))
+            wins += resume(p2, c2)
+    finally:
+        STATS, TRACK, LOGGING = saved; IN_ROLLOUT = False
+    return wins / WINCHANCE_N

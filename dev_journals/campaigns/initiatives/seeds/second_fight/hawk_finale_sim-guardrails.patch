+      16: ((365, 373), (291, 299), (217, 225)), 17: ((390, 398), (311, 319), (232, 240)),
+      18: ((415, 423), (331, 339), (247, 255)), 19: ((440, 448), (351, 359), (262, 270)),
+      20: ((465, 473), (371, 379), (277, 285))}
+# Maximum / Minimum
+RESIST = {14: (17, 9), 15: (18, 9), 16: (19, 9), 17: (19, 10), 18: (20, 10), 19: (21, 11), 20: (22, 11)}
+# Extreme / High / Moderate / Low
+ATTACK = {14: (31, 29, 27, 23), 15: (32, 30, 28, 24), 16: (34, 32, 30, 25), 17: (35, 33, 31, 27),
+          18: (37, 35, 33, 28), 19: (38, 36, 34, 29), 20: (40, 38, 36, 31)}
+# Average damage: Extreme / High / Moderate / Low
+DAMAGE = {14: (43, 34, 28, 23), 15: (45, 36, 30, 24), 16: (48, 37, 31, 25), 17: (50, 38, 32, 26),
+          18: (53, 40, 33, 27), 19: (55, 42, 35, 28), 20: (58, 44, 37, 29)}
+# Spell DC: Extreme / High / Moderate
+SPELL_DC = {14: (39, 34, 31), 15: (40, 36, 33), 16: (41, 37, 34), 17: (43, 38, 35),

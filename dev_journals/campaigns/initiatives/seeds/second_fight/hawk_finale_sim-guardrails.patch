+# Area damage average: Unlimited use / Limited use
+AREA = {14: (26, 53), 15: (27, 56), 16: (28, 60), 17: (29, 63), 18: (30, 67), 19: (32, 70), 20: (33, 74)}
+
+# Encounter budget (4 PCs): threat -> (XP budget, character adjustment)
+BUDGET = {"Trivial": (40, 10), "Low": (60, 15), "Moderate": (80, 20), "Severe": (120, 30), "Extreme": (160, 40)}
+CREATURE_XP = {-4: 10, -3: 15, -2: 20, -1: 30, 0: 40, 1: 60, 2: 80, 3: 120, 4: 160}
+
+OK, WARN = "ok", "OFF"
+
+def _row(table, level):
+    if level not in table:
+        raise KeyError(f"No benchmark row for level {level}; add it to pf2e_benchmarks.py")
+    return table[level]
+
+def _tier(value, row, names):
+    """Name the highest tier the value reaches. Above the top tier or below the bottom is OFF."""
+    if value > row[0]: return WARN, f"above {names[0]} ({row[0]})"
+    for v, n in zip(row, names):
+        if value == v: return OK, n
+        if value > v: return OK, f"between {n} and {names[names.index(n) - 1]}"
+    return WARN, f"below {names[-1]} ({row[-1]})"
+
+def avg(dice):
+    """'3d10+18' -> 34.5. Also accepts a plain number."""
+    if isinstance(dice, (int, float)): return float(dice)
+    total, s = 0.0, dice.replace(" ", "").replace("-", "+-")
+    for part in s.split("+"):
+        if not part: continue
+        if "d" in part:
+            n, d = part.split("d"); total += int(n or 1) * (int(d) + 1) / 2
+        else:
+            total += int(part)
+    return total
+
+def check_creature(spec):
+    """spec: dict with name, level and any of: hp, ac, perception, fort, ref, will, resist, weakness,
+    strikes [(name, attack, dice)], dcs [(name, dc)], areas [(name, dice, 'limited'|'unlimited')],
+    extra [(name, dice)] for damage that has no table (checked against published examples by hand).
+    Returns a list of (status, stat, value, verdict)."""
+    L = spec["level"]; out = []
+    if "hp" in spec:
+        (hmin, hmax), (mmin, mmax), (lmin, lmax) = _row(HP, L); hp = spec["hp"]
+        if hp > hmax: out.append((WARN, "HP", hp, f"above High ({hmin}-{hmax})"))
+        elif hp < lmin: out.append((WARN, "HP", hp, f"below Low ({lmin}-{lmax})"))
+        else:
+            t = "High" if hp >= hmin else "between Moderate and High" if hp > mmax else "Moderate" if hp >= mmin \
+                else "between Low and Moderate" if hp > lmax else "Low"
+            out.append((OK, "HP", hp, t))
+    if "ac" in spec: out.append((*_tier(spec["ac"], _row(AC, L), ("Extreme", "High", "Moderate", "Low"))[:1], "AC", spec["ac"],
+                                 _tier(spec["ac"], _row(AC, L), ("Extreme", "High", "Moderate", "Low"))[1]))
+    names5 = ("Extreme", "High", "Moderate", "Low", "Terrible")
+    for k, label in (("perception", "Perception"), ("fort", "Fortitude"), ("ref", "Reflex"), ("will", "Will")):
+        if k in spec:
+            st, v = _tier(spec[k], _row(SAVES, L), names5); out.append((st, label, f"+{spec[k]}", v))
+    mx, mn = _row(RESIST, L)
+    for k in ("resist", "weakness"):
+        if k in spec:
+            v = spec[k]; ok = mn <= v <= mx
+            out.append((OK if ok else WARN, k.capitalize(), v, f"range {mn}-{mx}"))
+    for name, atk, dice in spec.get("strikes", []):
+        st, v = _tier(atk, _row(ATTACK, L), ("Extreme", "High", "Moderate", "Low"))
+        out.append((st, f"{name} attack", f"+{atk}", v))
+        a = avg(dice); st, v = _tier(a, _row(DAMAGE, L), ("Extreme", "High", "Moderate", "Low"))
+        out.append((st, f"{name} damage", f"{dice} ({a:g})", v))
+    for name, dc in spec.get("dcs", []):
+        st, v = _tier(dc, _row(SPELL_DC, L), ("Extreme", "High", "Moderate"))
+        out.append((st, f"{name} DC", dc, v))
+    unl, lim = _row(AREA, L)
+    for name, dice, use in spec.get("areas", []):
+        a = avg(dice); cap = lim if use == "limited" else unl
+        out.append((OK if a <= cap * 1.05 else WARN, f"{name} ({use})", f"{dice} ({a:g})", f"benchmark {cap}"))
+    for name, dice, note in spec.get("extra", []):
+        out.append(("note", name, f"{dice} ({avg(dice):g})", note))
+    return out
+
+def print_checks(spec):
+    rows = check_creature(spec)
+    bad = [r for r in rows if r[0] == WARN]
+    print(f"\nBenchmarks: {spec['name']} (level {spec['level']}) - "
+          + ("all inside GM Core" if not bad else f"{len(bad)} OFF-CHART"))
+    for st, stat, val, verdict in rows:
+        mark = {"ok": "  ", "OFF": "!!", "note": " ?"}[st]
+        print(f"  {mark} {stat:24s} {str(val):20s} {verdict}")
+    return bad
+
+def encounter_readout(party_level, party_size, creature_levels, label=""):
+    """XP for the creatures, and the threat tier for this party size."""
+    xp = 0
+    for lvl in creature_levels:
+        diff = lvl - party_level
+        if diff > 4: raise ValueError(f"A level-{lvl} creature is more than 4 levels above the party")
+        xp += CREATURE_XP.get(diff, 0)
+    budgets = {t: b - a * (4 - party_size) for t, (b, a) in BUDGET.items()}
+    tier = "Trivial"
+    for t in ("Low", "Moderate", "Severe", "Extreme"):
+        if xp >= budgets[t]: tier = t
+    over = xp > budgets["Extreme"]
+    print(f"\nEncounter budget{(' - ' + label) if label else ''}: {party_size} PCs at level {party_level} vs "
+          f"creature level{'s' if len(creature_levels) > 1 else ''} {', '.join(map(str, creature_levels))}")
+    print(f"  {xp} XP -> {tier}" + ("  !! above Extreme" if over else "")
+          + "   (budgets for this party: " + ", ".join(f"{t} {b}" for t, b in budgets.items() if t != "Trivial") + ")")
+    return xp, tier
